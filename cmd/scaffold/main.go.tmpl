package main

import (
	"context"
	"errors"
	"fmt"
	"os"
	"os/signal"
	"syscall"

	"github.com/up2jj/wuko/plugin/sdk"
)

func main() {
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()
	if err := run(ctx); err != nil && !errors.Is(err, context.Canceled) {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}

func run(ctx context.Context) error {
	plugin, err := newPlugin()
	if err != nil {
		return err
	}
	return plugin.Serve(ctx, os.Stdin, os.Stdout)
}

func newPlugin() (*sdk.Plugin, error) {
	plugin, err := sdk.New("{{NS}}")
	if err != nil {
		return nil, err
	}
	registrations := []func(*sdk.Plugin) error{
		registerLifecycle,
		registerSlug,
		registerUppercase,
		registerLocalExecutor,
	}
	for _, register := range registrations {
		if err := register(plugin); err != nil {
			return nil, err
		}
	}
	return plugin, nil
}
