package main

import (
	"bufio"
	"context"
	"encoding/base64"
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"os"
	"os/signal"
	"strconv"
	"sync"
	"sync/atomic"
	"syscall"
)

const maxProtocolFrame = 10 << 20

type request struct {
	ID     string          `json:"id"`
	Method string          `json:"method"`
	Params json.RawMessage `json:"params"`
}
type response struct {
	ID     string          `json:"id"`
	Result json.RawMessage `json:"result,omitempty"`
	Error  *rpcError       `json:"error,omitempty"`
}
type outgoingResponse struct {
	ID     string    `json:"id"`
	Result any       `json:"result,omitempty"`
	Error  *rpcError `json:"error,omitempty"`
}
type rpcError struct {
	Code    string `json:"code,omitempty"`
	Message string `json:"message"`
}

type peer struct {
	out       io.Writer
	writeMu   sync.Mutex
	mu        sync.Mutex
	active    map[string]context.CancelFunc
	callbacks map[string]chan response
	abandoned map[string]struct{}
	next      atomic.Uint64
	wg        sync.WaitGroup
}

type requestContextKey struct{}
type peerContextKey struct{}

func main() {
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()
	if err := run(ctx); err != nil {
		fmt.Fprintln(os.Stderr, err)
	}
}

func run(root context.Context) error {
	p := &peer{out: os.Stdout, active: make(map[string]context.CancelFunc), callbacks: make(map[string]chan response), abandoned: make(map[string]struct{})}
	go func() { <-root.Done(); p.cancelAll(); _ = os.Stdin.Close() }()
	scanner := bufio.NewScanner(os.Stdin)
	scanner.Buffer(make([]byte, 64<<10), maxProtocolFrame)
	shuttingDown := false
	for scanner.Scan() {
		line := append([]byte(nil), scanner.Bytes()...)
		var envelope struct {
			ID     string `json:"id"`
			Method string `json:"method"`
		}
		if err := json.Unmarshal(line, &envelope); err != nil || envelope.ID == "" && envelope.Method != "cancel" {
			return fmt.Errorf("malformed protocol frame")
		}
		if envelope.Method == "" {
			var reply response
			if err := json.Unmarshal(line, &reply); err != nil || (reply.Error == nil) == (reply.Result == nil) {
				return fmt.Errorf("malformed callback response %q", envelope.ID)
			}
			if !p.deliver(reply) {
				return fmt.Errorf("unknown callback response %q", envelope.ID)
			}
			continue
		}
		var req request
		if err := json.Unmarshal(line, &req); err != nil {
			return fmt.Errorf("decoding request: %w", err)
		}
		if req.ID == "" {
			if req.Method != "cancel" {
				return fmt.Errorf("notification %q is unsupported", req.Method)
			}
			var params struct {
				ID string `json:"id"`
			}
			if err := json.Unmarshal(req.Params, &params); err != nil || params.ID == "" {
				return fmt.Errorf("invalid cancel notification")
			}
			p.cancel(params.ID)
			continue
		}
		if req.Method == "shutdown" {
			if shuttingDown {
				return fmt.Errorf("duplicate shutdown request")
			}
			shuttingDown = true
			p.cancelAll()
			go func() { p.wg.Wait(); _ = p.reply(req.ID, map[string]any{}, nil) }()
			continue
		}
		if shuttingDown {
			_ = p.reply(req.ID, nil, errors.New("plugin is shutting down"))
			continue
		}
		ctx, cancel := context.WithCancel(root)
		ctx = context.WithValue(ctx, requestContextKey{}, req.ID)
		ctx = context.WithValue(ctx, peerContextKey{}, p)
		if !p.add(req.ID, cancel) {
			cancel()
			return fmt.Errorf("duplicate request id %q", req.ID)
		}
		p.wg.Go(func() {
			defer p.remove(req.ID)
			result, err := dispatch(ctx, req, p)
			_ = p.reply(req.ID, result, err)
		})
	}
	if err := scanner.Err(); err != nil && root.Err() == nil {
		return fmt.Errorf("reading protocol: %w", err)
	}
	p.cancelAll()
	p.wg.Wait()
	return nil
}

func (p *peer) add(id string, cancel context.CancelFunc) bool {
	p.mu.Lock()
	defer p.mu.Unlock()
	if _, ok := p.active[id]; ok {
		return false
	}
	p.active[id] = cancel
	return true
}
func (p *peer) remove(id string) {
	p.mu.Lock()
	cancel := p.active[id]
	delete(p.active, id)
	p.mu.Unlock()
	if cancel != nil {
		cancel()
	}
}
func (p *peer) cancel(id string) {
	p.mu.Lock()
	cancel := p.active[id]
	p.mu.Unlock()
	if cancel != nil {
		cancel()
	}
}
func (p *peer) cancelAll() {
	p.mu.Lock()
	cancels := make([]context.CancelFunc, 0, len(p.active))
	for _, cancel := range p.active {
		cancels = append(cancels, cancel)
	}
	p.mu.Unlock()
	for _, cancel := range cancels {
		cancel()
	}
}
func (p *peer) deliver(reply response) bool {
	p.mu.Lock()
	target := p.callbacks[reply.ID]
	if target != nil {
		delete(p.callbacks, reply.ID)
	}
	_, abandoned := p.abandoned[reply.ID]
	if abandoned {
		delete(p.abandoned, reply.ID)
	}
	p.mu.Unlock()
	if target == nil {
		return abandoned
	}
	target <- reply
	return true
}

func (p *peer) write(value any) error {
	data, err := json.Marshal(value)
	if err != nil {
		return err
	}
	if len(data) > maxProtocolFrame {
		return fmt.Errorf("protocol frame exceeds 10 MiB")
	}
	p.writeMu.Lock()
	defer p.writeMu.Unlock()
	_, err = p.out.Write(append(data, '\n'))
	return err
}
func (p *peer) reply(id string, result any, err error) error {
	reply := outgoingResponse{ID: id, Result: result}
	if err != nil {
		reply.Result = nil
		reply.Error = &rpcError{Message: err.Error()}
	}
	return p.write(reply)
}
func (p *peer) event(id, kind string, data []byte) error {
	return p.write(map[string]any{"id": id, "event": kind, "data": base64.StdEncoding.EncodeToString(data)})
}

// CallHost performs one declared protocol-v2 callback using the current host request as parent.
func CallHost(ctx context.Context, method string, params map[string]any, result any) error {
	p, ok := ctx.Value(peerContextKey{}).(*peer)
	if !ok {
		return fmt.Errorf("host peer is unavailable")
	}
	parent, ok := ctx.Value(requestContextKey{}).(string)
	if !ok {
		return fmt.Errorf("parent request is unavailable")
	}
	id := "plugin-" + strconv.FormatUint(p.next.Add(1), 10)
	wireParams := make(map[string]any, len(params)+1)
	for key, value := range params {
		wireParams[key] = value
	}
	wireParams["parent_id"] = parent
	encodedParams, err := json.Marshal(wireParams)
	if err != nil {
		return fmt.Errorf("encoding host callback: %w", err)
	}
	replies := make(chan response, 1)
	p.mu.Lock()
	p.callbacks[id] = replies
	p.mu.Unlock()
	if err := p.write(request{ID: id, Method: method, Params: encodedParams}); err != nil {
		p.mu.Lock()
		delete(p.callbacks, id)
		p.mu.Unlock()
		return err
	}
	select {
	case reply := <-replies:
		if reply.Error != nil {
			return errors.New(reply.Error.Message)
		}
		if result != nil {
			return json.Unmarshal(reply.Result, result)
		}
		return nil
	case <-ctx.Done():
		p.mu.Lock()
		delete(p.callbacks, id)
		p.abandoned[id] = struct{}{}
		p.mu.Unlock()
		return ctx.Err()
	}
}

func dispatch(ctx context.Context, req request, p *peer) (any, error) {
	switch req.Method {
	case "initialize":
		var params struct {
			Protocol string `json:"protocol"`
		}
		if err := json.Unmarshal(req.Params, &params); err != nil {
			return nil, err
		}
		if params.Protocol != protocolVersion {
			return nil, fmt.Errorf("unsupported protocol %q", params.Protocol)
		}
		return map[string]any{"protocol": protocolVersion, "namespace": "{{NS}}", "lifecycle": true, "helpers": []any{map[string]any{"name": "slug"}}, "steps": []any{map[string]any{"type": "{{NS}}.uppercase"}}, "executors": []any{map[string]any{"type": "{{NS}}.local", "cancel_stops_process": true}}}, nil
	case "plugin.start":
		var params struct {
			With map[string]any `json:"with"`
		}
		if err := json.Unmarshal(req.Params, &params); err != nil {
			return nil, err
		}
		return map[string]any{}, Start(ctx, params.With)
	case "plugin.stop":
		var params struct {
			Reason string `json:"reason"`
		}
		if err := json.Unmarshal(req.Params, &params); err != nil {
			return nil, err
		}
		return map[string]any{}, Stop(ctx, params.Reason)
	case "helper.call":
		return callHelper(req.Params)
	case "step.validate", "executor.validate", "executor.close":
		return map[string]any{}, nil
	case "step.run":
		return runUppercase(req.Params)
	case "executor.open":
		return map[string]any{"session": "local"}, nil
	case "executor.run":
		return runLocal(ctx, req, p)
	default:
		return nil, fmt.Errorf("unknown method %s", req.Method)
	}
}
