package main

import (
	"context"
	"fmt"
	"strings"

	"github.com/up2jj/wuko/plugin/sdk"
)

type uppercaseConfig struct {
	Value string `json:"value"`
}

func registerUppercase(plugin *sdk.Plugin) error {
	handler := sdk.StepHandler[uppercaseConfig]{
		Validate: validateUppercase,
		Run:      runUppercase,
	}
	outputs := sdk.Object(map[string]sdk.OutputSchema{"value": sdk.Scalar()})
	return sdk.RegisterStep(plugin, "uppercase", handler, sdk.WithOutputSchema(outputs))
}

func validateUppercase(_ context.Context, request sdk.ValidateRequest[uppercaseConfig]) error {
	return validateUppercaseConfig(request.Config)
}

func validateUppercaseConfig(config uppercaseConfig) error {
	if config.Value == "" {
		return fmt.Errorf("value is required")
	}
	return nil
}

func runUppercase(_ context.Context, request sdk.RunRequest[uppercaseConfig]) (sdk.Result, error) {
	if err := validateUppercaseConfig(request.Config); err != nil {
		return sdk.Result{}, err
	}
	return sdk.Result{Outputs: map[string]any{"value": strings.ToUpper(request.Config.Value)}}, nil
}
