package main

import (
	"context"
	"fmt"
	"regexp"
	"strings"

	"github.com/up2jj/wuko/plugin/sdk"
)

var nonSlug = regexp.MustCompile(`[^a-z0-9]+`)

func registerSlug(plugin *sdk.Plugin) error {
	return plugin.RegisterHelper("slug", slug)
}

func slug(_ context.Context, args []any) (any, error) {
	if len(args) != 1 {
		return nil, fmt.Errorf("slug requires one argument")
	}
	value, ok := args[0].(string)
	if !ok {
		return nil, fmt.Errorf("slug argument must be a string")
	}
	value = strings.ToLower(strings.TrimSpace(value))
	return strings.Trim(nonSlug.ReplaceAllString(value, "-"), "-"), nil
}
