package main

import (
	"bytes"
	"encoding/json"
	"io"
	"testing"

	"github.com/up2jj/wuko/plugin/sdk"
)

func TestUppercase(t *testing.T) {
	request := sdk.StepRequest[uppercaseConfig]{Config: uppercaseConfig{Value: "hello"}}
	result, err := runUppercase(t.Context(), request)
	if err != nil {
		t.Fatal(err)
	}
	if result.Outputs["value"] != "HELLO" {
		t.Fatal(result)
	}
}

func TestSlug(t *testing.T) {
	result, err := slug(t.Context(), []any{"Hello World"})
	if err != nil {
		t.Fatal(err)
	}
	if result != "hello-world" {
		t.Fatal(result)
	}
}

func TestOutputPolicies(t *testing.T) {
	for policy := range 4 {
		var stream bytes.Buffer
		sink := &outputSink{stream: &stream, policy: policy, limit: 3, budget: &captureBudget{remaining: maxResponseCapture}}
		if _, err := sink.Write([]byte("hello")); err != nil {
			t.Fatal(err)
		}
		value, truncated := sink.result()
		wantStream := policy == 0 || policy == 1
		wantCapture := policy == 0 || policy == 2
		if (stream.Len() > 0) != wantStream {
			t.Fatalf("policy %d stream=%v", policy, stream.Len() > 0)
		}
		if wantCapture {
			if value != "hel" || !truncated {
				t.Fatalf("policy %d capture=%q truncated=%v", policy, value, truncated)
			}
		} else if value != "" || truncated {
			t.Fatalf("policy %d capture=%q truncated=%v", policy, value, truncated)
		}
	}
}

func TestCaptureTransportCeiling(t *testing.T) {
	sink := &outputSink{stream: &bytes.Buffer{}, policy: 2, budget: &captureBudget{remaining: maxResponseCapture}}
	data := bytes.Repeat([]byte{'x'}, maxResponseCapture+1)
	if _, err := sink.Write(data); err != nil {
		t.Fatal(err)
	}
	value, truncated := sink.result()
	if len(value) != maxResponseCapture || !truncated {
		t.Fatalf("capture=%d truncated=%v", len(value), truncated)
	}
}

func TestPluginRegistersWithSDK(t *testing.T) {
	plugin, err := newPlugin()
	if err != nil {
		t.Fatal(err)
	}
	input, inputWriter := io.Pipe()
	outputReader, output := io.Pipe()
	done := make(chan error, 1)
	go func() { done <- plugin.Serve(t.Context(), input, output) }()
	encoder := json.NewEncoder(inputWriter)
	decoder := json.NewDecoder(outputReader)
	if err := encoder.Encode(map[string]any{"id": "initialize", "method": "initialize", "params": map[string]any{"protocol": sdk.Protocol}}); err != nil {
		t.Fatal(err)
	}
	var response struct {
		Result struct {
			Protocol  string `json:"protocol"`
			Namespace string `json:"namespace"`
		} `json:"result"`
	}
	if err := decoder.Decode(&response); err != nil {
		t.Fatal(err)
	}
	if response.Result.Protocol != sdk.Protocol || response.Result.Namespace != "{{NS}}" {
		t.Fatalf("initialize result = %#v", response.Result)
	}
	if err := inputWriter.Close(); err != nil {
		t.Fatal(err)
	}
	if err := <-done; err != nil {
		t.Fatal(err)
	}
}
