package main

import (
	"bytes"
	"context"
	"errors"
	"fmt"
	"io"
	"os"
	"os/exec"
	"sync"
	"syscall"
	"time"

	"github.com/up2jj/wuko/plugin/sdk"
)

const maxResponseCapture = (10<<20 - 64<<10) / 6

type captureBudget struct {
	mu        sync.Mutex
	remaining int64
}

type outputSink struct {
	mu        sync.Mutex
	stream    io.Writer
	policy    int
	limit     int64
	budget    *captureBudget
	captured  []byte
	truncated bool
}

func (writer *outputSink) Write(data []byte) (int, error) {
	writer.mu.Lock()
	defer writer.mu.Unlock()
	if writer.policy == 0 || writer.policy == 1 {
		if _, err := writer.stream.Write(data); err != nil {
			return 0, err
		}
	}
	if writer.policy == 0 || writer.policy == 2 {
		allowed := int64(len(data))
		if writer.limit > 0 {
			allowed = min(allowed, max(writer.limit-int64(len(writer.captured)), 0))
		}
		writer.budget.mu.Lock()
		allowed = min(allowed, writer.budget.remaining)
		writer.budget.remaining -= allowed
		writer.budget.mu.Unlock()
		writer.captured = append(writer.captured, data[:allowed]...)
		if allowed < int64(len(data)) {
			writer.truncated = true
		}
	}
	return len(data), nil
}

func (writer *outputSink) result() (string, bool) {
	writer.mu.Lock()
	defer writer.mu.Unlock()
	return string(writer.captured), writer.truncated
}

type localConfig struct{}
type localSession struct{}

func registerLocalExecutor(plugin *sdk.Plugin) error {
	handler := sdk.ExecutorHandler[localConfig]{
		Open: func(context.Context, sdk.ExecutorRequest[localConfig]) (sdk.ExecutorSession, error) {
			return localSession{}, nil
		},
		CancelStopsProcess: true,
	}
	return sdk.RegisterExecutor(plugin, "local", handler)
}

func (localSession) Run(ctx context.Context, command sdk.Command) (sdk.CommandResult, error) {
	if command.Command == "" {
		return sdk.CommandResult{}, fmt.Errorf("command is required")
	}
	if command.CaptureLimit < 0 {
		return sdk.CommandResult{}, fmt.Errorf("capture_limit must not be negative")
	}
	if command.StdoutPolicy < 0 || command.StdoutPolicy > 3 || command.StderrPolicy < 0 || command.StderrPolicy > 3 {
		return sdk.CommandResult{}, fmt.Errorf("invalid output policy")
	}
	process := exec.Command(command.Command, command.Args...)
	process.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
	process.Dir = command.Dir
	process.Env = os.Environ()
	for name, value := range command.Env {
		process.Env = append(process.Env, name+"="+value)
	}
	process.Stdin = bytes.NewReader(command.Stdin)
	budget := &captureBudget{remaining: maxResponseCapture}
	stdout := &outputSink{stream: command.Stdout, policy: command.StdoutPolicy, limit: command.CaptureLimit, budget: budget}
	stderr := &outputSink{stream: command.Stderr, policy: command.StderrPolicy, limit: command.CaptureLimit, budget: budget}
	process.Stdout = stdout
	process.Stderr = stderr
	if err := process.Start(); err != nil {
		return sdk.CommandResult{}, err
	}
	if command.Started != nil {
		command.Started()
	}
	done := make(chan error, 1)
	go func() { done <- process.Wait() }()
	var err error
	var canceled error
	select {
	case err = <-done:
	case <-ctx.Done():
		canceled = ctx.Err()
		_ = signalCommandGroup(process, syscall.SIGTERM)
		timer := time.NewTimer(time.Second)
		select {
		case err = <-done:
			if !timer.Stop() {
				<-timer.C
			}
		case <-timer.C:
			_ = signalCommandGroup(process, syscall.SIGKILL)
			err = <-done
		}
	}
	exitCode := 0
	if process.ProcessState != nil {
		exitCode = process.ProcessState.ExitCode()
		var exitError *exec.ExitError
		if errors.As(err, &exitError) {
			err = nil
		}
	}
	stdoutValue, stdoutTruncated := stdout.result()
	stderrValue, stderrTruncated := stderr.result()
	result := sdk.CommandResult{
		Stdout:          stdoutValue,
		Stderr:          stderrValue,
		ExitCode:        exitCode,
		StdoutTruncated: stdoutTruncated,
		StderrTruncated: stderrTruncated,
	}
	return result, errors.Join(canceled, err)
}

func (localSession) Close(context.Context) error { return nil }

func signalCommandGroup(command *exec.Cmd, signal syscall.Signal) error {
	if command == nil || command.Process == nil {
		return nil
	}
	err := syscall.Kill(-command.Process.Pid, signal)
	if errors.Is(err, syscall.ESRCH) {
		return nil
	}
	return err
}
